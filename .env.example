# Copiez ce fichier en `.env` et complétez les valeurs (jamais commité).

# Backend (services/backend/app/main.py) — lus via os.environ.get, avec ces
# mêmes valeurs par défaut si absents. Utile si vous lancez le backend hors
# docker compose (les valeurs de docker-compose.yml priment sinon).
MODEL_URL=http://model:8000
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# CI GitHub Actions — secret de repo (Settings > Secrets and variables >
# Actions), PAS une valeur à mettre ici pour la CI. Uniquement utile en local
# si vous testez l'appel webhook vous-même.
# DISCORD_WEBHOOK_URL=
