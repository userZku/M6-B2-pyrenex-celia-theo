{
  "uid": "pyrenex-drift",
  "title": "Pyrenex Drift — suivi dérive v2",
  "tags": [
    "pyrenex",
    "m6",
    "drift"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Comportement — probabilites predites (mediane / p90)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "Le modele hesite-t-il plus qu'avant ? Histogram expose par le service model (M5) : passer par _bucket + rate() + histogram_quantile().",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum(rate(pyrenex_prediction_proba_bucket[1h])) by (le))",
          "legendFormat": "mediane"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.9, sum(rate(pyrenex_prediction_proba_bucket[1h])) by (le))",
          "legendFormat": "p90"
        }
      ]
    },
    {
      "id": 2,
      "title": "Comportement — repartition des classes predites",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "description": "La proportion de defauts annonces a-t-elle bouge ? Compteur pyrenex_predictions_total (M5), labelle par classe predite.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pyrenex_predictions_total[5m])) by (predicted_class)",
          "legendFormat": "classe {{predicted_class}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Contexte — volume et taux d'erreur",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "description": "Y a-t-il assez de trafic pour conclure ? Une bascule de distribution sur 3 requetes ne veut rien dire.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\"model|backend\"}[5m]))",
          "legendFormat": "RPS total"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\"model|backend\",status=~\"4..|5..\"}[5m])) or vector(0)",
          "legendFormat": "erreurs 4xx/5xx"
        }
      ]
    }
  ]
}
