    {
      "id": 13,
      "type": "timeseries",
      "title": "Contexte | Volume et taux d'erreur",
      "description": "Volume de requetes du modele et taux de reponses 4xx/5xx, calcules en direct depuis les compteurs HTTP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"model\"}[5m]))",
          "legendFormat": "volume total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(http_requests_total{job=\"model\",status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"model\"}[5m])), 0.000001)",
          "legendFormat": "taux d'erreur",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "taux d'erreur"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
